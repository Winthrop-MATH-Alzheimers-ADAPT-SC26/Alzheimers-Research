Cell[CellGroupData[{

Cell["Computation", "Subsection",
 CellChangeTimes->{{3.988376337258842*^9, 
  3.988376348475576*^9}},ExpressionUUID->"2704e282-a834-49c5-91dc-\
46b63587fcc5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"soln", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ABeta", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"a1", " ", "-", " ", 
         RowBox[{"r1", " ", "*", " ", 
          RowBox[{"ABeta", "[", "t", "]"}]}], " ", "+", " ", 
         RowBox[{"a2", " ", "*", " ", 
          FractionBox[
           RowBox[{"Ca", "[", "t", "]"}], 
           RowBox[{
            RowBox[{"Ca", "[", "t", "]"}], "+", "\[Sigma]"}]]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Ca", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"b1", " ", "-", " ", 
         RowBox[{"r2", " ", "*", " ", 
          RowBox[{"Ca", "[", "t", "]"}]}], " ", "+", " ", 
         RowBox[{"b2", "*", 
          RowBox[{"ABeta", "[", "t", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"ABeta", "[", "0", "]"}], "==", "0.0"}], ",", 
       RowBox[{
        RowBox[{"Ca", "[", "0", "]"}], "==", "0.0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ABeta", ",", "Ca"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "60"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"numericalequil", " ", "=", " ", 
  RowBox[{"NSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"a1", " ", "-", " ", 
        RowBox[{"r1", " ", "*", " ", "ABeta"}], " ", "+", " ", 
        RowBox[{"a2", " ", "*", " ", 
         FractionBox["Ca", 
          RowBox[{"Ca", "+", "\[Sigma]"}]]}]}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"b1", " ", "-", " ", 
        RowBox[{"r2", " ", "*", " ", "Ca"}], " ", "+", " ", 
        RowBox[{"b2", "*", "ABeta"}]}], "==", "0"}], ",", 
      RowBox[{"ABeta", ">=", "0"}], ",", 
      RowBox[{"Ca", ">=", "0"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"ABeta", ",", "Ca"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.988373819759118*^9, 3.988373847960093*^9}, {
   3.988373881290365*^9, 3.9883738919763823`*^9}, {3.98837404600918*^9, 

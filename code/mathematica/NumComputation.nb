Cell[BoxData[{
 RowBox[{
  RowBox[{"soln", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ABeta", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"a1", " ", "-", " ", 
         RowBox[{"r1", " ", "*", " ", 
          RowBox[{"ABeta", "[", "t", "]"}]}], " ", "+", " ", 
         RowBox[{"a2", " ", "*", " ", 
          FractionBox[
           RowBox[{"Ca", "[", "t", "]"}], 
           RowBox[{
            RowBox[{"Ca", "[", "t", "]"}], "+", "\[Sigma]"}]]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Ca", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"b1", " ", "-", " ", 
         RowBox[{"r2", " ", "*", " ", 
          RowBox[{"Ca", "[", "t", "]"}]}], " ", "+", " ", 
         RowBox[{"b2", "*", 
          RowBox[{"ABeta", "[", "t", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"ABeta", "[", "0", "]"}], "==", "0.0"}], ",", 
       RowBox[{
        RowBox[{"Ca", "[", "0", "]"}], "==", "0.0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ABeta", ",", "Ca"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "40"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"numericalequil", " ", "=", " ", 
  RowBox[{"NSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"a1", " ", "-", " ", 
        RowBox[{"r1", " ", "*", " ", "ABeta"}], " ", "+", " ", 
        RowBox[{"a2", " ", "*", " ", 
         FractionBox["Ca", 
          RowBox[{"Ca", "+", "\[Sigma]"}]]}]}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"b1", " ", "-", " ", 
        RowBox[{"r2", " ", "*", " ", "Ca"}], " ", "+", " ", 
        RowBox[{"b2", "*", "ABeta"}]}], "==", "0"}], ",", 
      RowBox[{"ABeta", ">=", "0"}], ",", 
      RowBox[{"Ca", ">=", "0"}]}], "}"}], ",", 
    RowBox[{"{", 
